  "info": {
    "title": "Pulse API",
    "description": "NRS TWG Initiative Tracker",
    "version": "1.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "lead@nrs.gov.ng",
            "description": "The user's Pulse account email."
          },
          "password": {
            "type": "string",
            "description": "The user's Pulse account password."
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "AuthUserDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "description": "Profile id — matches the Supabase auth user id."
          },
          "email": {
            "type": "string"
          },
          "fullName": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "admin",
              "smo",
              "workstream_lead"
            ],
            "description": "admin/smo can read and write everything. workstream_lead is scoped to workstreamId."
          },
          "workstreamId": {
            "type": "string",
            "nullable": true,
            "description": "The workstream this user is scoped to. Always null for admin/smo."
          }
        },
        "required": [
          "id",
          "email",
          "fullName",
          "role",
          "workstreamId"
        ]
      },
      "LoginResponseDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string",
            "description": "Bearer token — pass as `Authorization: Bearer <accessToken>`."
          },
          "refreshToken": {
            "type": "string",
            "description": "Supabase refresh token, for obtaining a new access token."
          },
          "expiresAt": {
            "type": "number",
            "description": "Unix epoch seconds at which accessToken expires."
          },
          "user": {
            "$ref": "#/components/schemas/AuthUserDto"
          }
        },
        "required": [
          "accessToken",
          "refreshToken",
          "expiresAt",
          "user"
        ]
      },
