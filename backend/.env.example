# Copy to .env and fill in with real values from Gideon. Never commit .env.
PORT=3000

# Supabase project settings → API
SUPABASE_URL=
# Client-facing key (safe for the eventual frontend, RLS-enforced)
SUPABASE_ANON_KEY=
# Server-only key — bypasses RLS. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=

# Deployed frontend origin(s), comma-separated (e.g. Vercel prod + preview URLs).
# Locks down CORS. Leave unset for local dev — CORS stays permissive then.
FRONTEND_URL=

# Optional. Signs the short-lived Users-section access tickets. Leave unset and
# the signing key is derived from SUPABASE_SERVICE_ROLE_KEY, which is fine —
# set it only if you want ticket lifetime decoupled from that key's rotation.
# Changing it just means admins re-enter the Users-section access code.
USERS_SECTION_TICKET_SECRET=
