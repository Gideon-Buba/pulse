# Copy to .env and fill in with real values from Gideon. Never commit .env.
PORT=3000

# Supabase project settings → API
SUPABASE_URL=
# Client-facing key (safe for the eventual frontend, RLS-enforced)
SUPABASE_ANON_KEY=
# Server-only key — bypasses RLS. Never expose to the frontend.
SUPABASE_SERVICE_ROLE_KEY=
